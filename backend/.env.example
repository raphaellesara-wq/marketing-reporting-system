# Application
APP_NAME=MarketingReportingSaaS
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=postgresql://mruser:mrpassword@postgres:5432/marketing_reporting
POSTGRES_DB=marketing_reporting
POSTGRES_USER=mruser
POSTGRES_PASSWORD=mrpassword

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# File Storage
UPLOAD_DIR=/app/uploads
REPORTS_DIR=/app/reports

# AES-256-GCM key for credential encryption (64 hex chars = 32 bytes)
# Generate: python -c "import os; print(os.urandom(32).hex())"
ENCRYPTION_KEY=your-64-hex-char-key-here
